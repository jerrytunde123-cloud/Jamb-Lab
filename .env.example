# Copy to .env.local (gitignored) and fill in:
#
#   VITE_UTMELAB_API_KEY=sk_...   # `cargo run -- key create --label <name>` in utmelab-api
#
# That is the only variable to configure. The API base URL is hardcoded
# in js/api.js (change it there when the API gets a public URL).
#
# The key is baked into the client bundle at build time (Vite replaces
# import.meta.env statically), so treat it as public: issue a limited,
# revocable key per deployment, never reuse a privileged one.
# On Vercel, set the same variables in the project dashboard instead.
VITE_UTMELAB_API_KEY=
